#!/bin/sh
# Pre-commit hook: blocklist + gitleaks

set -e

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    NC=''
fi

fail() {
    echo "${RED}FAILED:${NC} $1"
    exit 1
}

pass() {
    echo "${GREEN}OK:${NC} $1"
}

# Flush beads before inspecting staged content. The SQLite database is local
# and gitignored; issues.jsonl is the public export and must be sanitized after
# every flush because source_repo_path may contain an absolute checkout path.
if command -v br >/dev/null 2>&1 && [ -d .beads ]; then
    if ! br sync --flush-only >/dev/null 2>&1; then
        fail "failed to flush br changes to JSONL (run 'br sync --flush-only' manually)"
    fi

    BEADS_JSONL=.beads/issues.jsonl
    if [ -f .blocklist ] && [ -f "$BEADS_JSONL" ]; then
        sanitized=0
        while IFS= read -r pattern || [ -n "$pattern" ]; do
            case "$pattern" in
                ""|\#*) continue ;;
            esac
            if grep -qF "$pattern" "$BEADS_JSONL" 2>/dev/null; then
                if ! REDACT_PAT="$pattern" perl -pi \
                        -e 's{\Q$ENV{REDACT_PAT}\E}{[REDACTED]}g' "$BEADS_JSONL"; then
                    fail "redaction of '$pattern' failed"
                fi
                if grep -qF "$pattern" "$BEADS_JSONL" 2>/dev/null; then
                    fail "redaction of '$pattern' was incomplete"
                fi
                sanitized=1
            fi
        done < .blocklist
        if [ "$sanitized" = "1" ]; then
            # Redaction intentionally changes the exported JSONL after br
            # certified its hash. Import the sanitized form so the next hook
            # run does not fail the stale-JSONL guard or restore private data.
            if ! br sync --import-only --force >/dev/null 2>&1; then
                fail "failed to certify sanitized beads JSONL"
            fi
            pass "beads PII sanitized"
        fi
    fi

    if ! git add "$BEADS_JSONL"; then
        fail "failed to stage sanitized beads JSONL"
    fi
fi

# make gate: any staged src/ or Cargo.lock change must have a fresh PASS.
# docs/verification.md "Hooks". gate.json's staged_diff_sha256 must match the
# diff actually being committed — a gate run against a different change (or
# none at all) does not count.
staged_src=0
for file in $(git diff --cached --name-only --diff-filter=ACM); do
    case "$file" in
        src/*|Cargo.lock) staged_src=1 ;;
    esac
done
if [ "$staged_src" = "1" ]; then
    gate_json="target/gate/gate.json"
    if [ ! -f "$gate_json" ]; then
        fail "src/ or Cargo.lock is staged with no target/gate/gate.json — run 'make gate' first"
    fi
    if command -v jq >/dev/null 2>&1; then
        verdict=$(jq -r '.verdict' "$gate_json" 2>/dev/null || echo "")
        recorded_sha=$(jq -r '.staged_diff_sha256' "$gate_json" 2>/dev/null || echo "")
    else
        verdict=$(sed -n 's/.*"verdict": *"\([^"]*\)".*/\1/p' "$gate_json" | head -1)
        recorded_sha=$(sed -n 's/.*"staged_diff_sha256": *"\([^"]*\)".*/\1/p' "$gate_json" | head -1)
    fi
    current_sha=$( (git diff --cached; git diff) | sha256sum | awk '{print $1}')
    if [ "$verdict" != "PASS" ]; then
        fail "target/gate/gate.json verdict is '$verdict', not PASS — run 'make gate'"
    fi
    if [ "$recorded_sha" != "$current_sha" ]; then
        fail "target/gate/gate.json was written for a different change — run 'make gate' again"
    fi
    pass "make gate PASS for this change"
fi

# Large file check (1MB limit)
MAX_SIZE=1048576
for file in $(git diff --cached --name-only --diff-filter=ACM); do
    if [ -f "$file" ]; then
        size=$(wc -c < "$file" | tr -d ' ')
        if [ "$size" -gt "$MAX_SIZE" ]; then
            fail "$file is $(($size / 1024))KB (max 1MB)"
        fi
    fi
done
pass "no large files"

# Blocklist check (private domains, hostnames, etc.)
if [ -f ".blocklist" ]; then
    for file in $(git diff --cached --name-only --diff-filter=ACM); do
        # A blocklist necessarily contains its own patterns.
        [ "$file" = ".blocklist" ] && continue
        if [ -f "$file" ]; then
            while IFS= read -r pattern || [ -n "$pattern" ]; do
                case "$pattern" in
                    ""|\#*) continue ;;
                esac
                if grep -qF "$pattern" "$file" 2>/dev/null; then
                    fail "blocklisted pattern '$pattern' found in $file"
                fi
            done < .blocklist
        fi
    done
    pass "blocklist"
fi

# Gitleaks
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --no-banner; then
        fail "gitleaks found secrets"
    fi
    pass "gitleaks"
fi

echo ""
echo "${GREEN}All checks passed${NC}"
