{"component":"streamserver","level":"info","state":"degraded","f0":"v0" "f1":"v1" "f2":"v2" "f3":"v3" "f4":"v4" "f5":"v5" "f6":"v6" "f7":"v7" "f8":"v8" "f9":"v9" "f10":"v10" "f11":"v11" "f12":"v12" "f13":"v13" "f14":"v14" "f15":"v15" "f16":"v16" "f17":"v17" "f18":"v18" "f19":"v19" "f20":"v20" "f21":"v21" "f22":"v22" "f23":"v23" "f24":"v24" "f25":"v25" "f26":"v26" "f27":"v27" "f28":"v28" "f29":"v29" "f30":"v30" "f31":"v31" "f32":"v32" "f33":"v33" "f34":"v34" "f35":"v35" "f36":"v36" "f37":"v37" "f38":"v38" "f39":"v39" "f40":"v40" "f41":"v41" "f42":"v42" "f43":"v43" "f44":"v44" "f45":"v45" "f46":"v46" "f47":"v47" "f48":"v48" "f49":"v49" "f50":"v50" "f51":"v51" "f52":"v52" "f53":"v53" "f54":"v54" "f55":"v55" "f56":"v56" "f57":"v57" "f58":"v58" "f59":"v59"}
